# A complete mainnet.config for a lite validator, for when there is no validator configuration to
# copy. Replace LITE_DIR, NODE_DB and the values in <...>. All settings:
# docs/lite-validator/CONFIGURATION.md. The mainnet genesis is built into the package.

network.id=1

# Seed nodes: the same list as the validator uses (its mainnet.config / its environment), or the
# current mainnet seed nodes from the official Radix node documentation. One line, comma separated:
network.p2p.seed_nodes=<radix://node_rdx1...@host:30000,radix://node_rdx1...@host:30000,...>

# The public IP address of the host (as for the validator):
network.host_ip=<public IP address of the host>

# Own key and own data directory (install.sh checks both):
node.key.path=LITE_DIR/keystore.ks
db.location=LITE_DIR/data

# The state database of the validator; only read. This line makes the node a lite validator.
lite.primary_state_manager_path=NODE_DB/state_manager

# Own ports; the default ports of a node (30000, 3333-3336) are refused.
network.p2p.listen_port=30001
network.p2p.broadcast_port=30001
api.core.port=3343
api.core.bind_address=127.0.0.1
api.system.port=3344
api.system.bind_address=127.0.0.1
api.prometheus.port=3345
api.prometheus.bind_address=127.0.0.1
api.engine_state.port=3346
api.engine_state.bind_address=127.0.0.1

# Taking part in consensus (after a first run as a follower only, see INSTALL.md step 6):
# consensus.validator_address=<the lite validator's own, registered validator address>
# lite.primary_validator_address=<the address of the validator whose database is read>
